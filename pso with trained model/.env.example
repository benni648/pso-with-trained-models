# =====================================================================
# PSO Smart Traffic Signal Optimization — Environment Variables
# =====================================================================
# Copy to .env and adjust values:
#   cp .env.example .env
# =====================================================================

# ── Server ─────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-string

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://pso_user:pso_password@localhost:5432/pso_traffic
SQL_ECHO=false

# ── Redis / Cache ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL=300

# ── Celery ─────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── JWT Authentication ─────────────────────────────────────────
JWT_ENABLED=true
JWT_SECRET_KEY=generate-a-64-char-random-string-here-please-change-me
JWT_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=https://your-domain.com

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── PSO Optimizer ──────────────────────────────────────────────
PSO_N_PARTICLES=30
PSO_N_ITERATIONS=50
PSO_BOUNDS_MIN=5
PSO_BOUNDS_MAX=60
PSO_INERTIA_WEIGHT=0.7
PSO_COGNITIVE_COEFF=1.5
PSO_SOCIAL_COEFF=1.5

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ── Traffic Signal Controller (Phase 4, Step 4.5) ─────────────
# Base URL of the physical controller REST API. Leave empty to run
# against the built-in simulated controller.
CONTROLLER_URL=

# ── City Traffic Management Center (Phase 4, Step 4.5) ────────
# Base URL of the TMC SCADA/REST gateway for data exchange.
# Leave empty to run without TMC integration.
TMC_URL=
# API key sent as X-API-Key on every TMC request (optional).
TMC_API_KEY=
# Comma-separated webhook URLs that receive alert notifications
# (anomalies, emergency preemption, controller fallback).
TMC_WEBHOOK_URLS=

# ── Controller Protocol (Phase 5, Step 5.3) ─────────────────
# "rest" (default) → plain REST timings push
# "ntcip"          → NTCIP 1202-style phase-table adapter
CONTROLLER_PROTOCOL=rest

# ── Event Streaming (Phase 5, Step 5.1) ─────────────────────
# Set true + install kafka-python to mirror events to Kafka.
# Without it the event bridge runs in logging-only mode.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=pso.traffic.events